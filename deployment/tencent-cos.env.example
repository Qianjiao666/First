# Tencent Cloud static release settings for the MKJ browser bundle.
# Copy this file to deployment/tencent-cos.env for local use and keep that
# copy out of git. Credentials are intentionally omitted: inject them through
# the Tencent CLI credential helper or your CI secret store.

# COS bucket name, including the numeric app id suffix.
COS_BUCKET=example-1250000000
COS_REGION=ap-shanghai
COS_PREFIX=MKJ

# Point this at a generated static stage from build-community-release.ps1.
COS_SOURCE_DIR=deployment/MKJ-community-forum-tasks-20260811-static-r7
# Optional absolute path to the coscli executable.
COSCLI_BIN=coscli

# CDN invalidation settings (used by tencent-cdn-purge.ps1).
CDN_DOMAIN=static.example.com
CDN_PATHS=/*
CDN_FLUSH_TYPE=flush
TENCENTCLOUD_REGION=ap-shanghai
